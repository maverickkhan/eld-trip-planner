# Copy to .env (or set in your host's dashboard). All values are optional locally.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: set false on hosts that terminate TLS at their edge (Render, Railway, Fly).
# DJANGO_SECURE_SSL_REDIRECT=false
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex list; default already allows every *.vercel.app preview.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# --- Database (defaults to SQLite in the backend folder) ---
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- External services (free, key-less defaults) ---
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=eld-trip-planner/0.1 (your-email@example.com)
GEOCODER_COUNTRY_CODES=us
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20

# Cap OSRM's car-profile speeds to a realistic truck average.
TRUCK_MAX_AVERAGE_SPEED_MPH=60
